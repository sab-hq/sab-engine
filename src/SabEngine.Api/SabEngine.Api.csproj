<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SabEngine.Api — the CLI/API entry point (design doc, Section 4.1,
    "CLI/API to trigger and monitor workflows"). This is the composition
    root: the only project allowed to reference all five of the others.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Forces a single resolved version of Microsoft.CodeAnalysis.Common
      and Microsoft.CodeAnalysis.CSharp across the dependency graph.
      Without these, NuGet can't reconcile the versions EF Core Design's
      Workspaces needs against the versions Microsoft.PowerShell.SDK (via
      SabEngine.Execution) needs — error NU1107, one level at a time.
      NuGet's own error messages suggested exactly this fix each time.
      See pre-development-checklist.md, PD-7.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.9.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SabEngine.Core\SabEngine.Core.csproj" />
    <ProjectReference Include="..\SabEngine.Data\SabEngine.Data.csproj" />
    <ProjectReference Include="..\SabEngine.Orchestration\SabEngine.Orchestration.csproj" />
    <ProjectReference Include="..\SabEngine.Agent\SabEngine.Agent.csproj" />
    <ProjectReference Include="..\SabEngine.Execution\SabEngine.Execution.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
