<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    SabEngine.Api — the composition root, now also the minimal
    human-approval web UI. This is a real gap the original PD-1–PD-29
    checklist never itemized: the state machine enforces that a human
    must approve a plan, but nothing existed yet for a human to actually
    look at. See pre-development-checklist.md, PD-30.

    Switched from Microsoft.NET.Sdk to Microsoft.NET.Sdk.Web to get
    Kestrel/ASP.NET Core web hosting (WebApplication.CreateBuilder)
    without adding packages by hand — the Web SDK brings the shared
    ASP.NET Core framework reference implicitly.
  -->
  <PropertyGroup>
    <!--
      NU1608 fires because we deliberately pin Microsoft.CodeAnalysis.Common
      and Microsoft.CodeAnalysis.CSharp to 4.9.2 below — newer than what
      EF Core Design's Workspaces package (4.5.0) technically declares it
      wants. That pin is the actual fix for a real NU1107 version conflict
      between Microsoft.PowerShell.SDK and EF Core Design (see PD-7 in
      pre-development-checklist.md). NU1608 is just NuGet noting the pin
      exists, not a real problem — safe to suppress here specifically,
      not globally, so a genuine future NU1608 elsewhere still surfaces.
    -->
    <NoWarn>NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.9.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SabEngine.Core\SabEngine.Core.csproj" />
    <ProjectReference Include="..\SabEngine.Data\SabEngine.Data.csproj" />
    <ProjectReference Include="..\SabEngine.Orchestration\SabEngine.Orchestration.csproj" />
    <ProjectReference Include="..\SabEngine.Agent\SabEngine.Agent.csproj" />
    <ProjectReference Include="..\SabEngine.Execution\SabEngine.Execution.csproj" />
  </ItemGroup>
</Project>
